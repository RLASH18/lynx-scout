{
    "name": "rlash18/lynx-scout",
    "description": "Automated performance intelligence and recommendations for Laravel 13.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ryan Lester Lacdang",
            "email": "lacdangryan18@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "nunomaduro/termwind": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Lynx\\Scout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lynx\\Scout\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lynx\\Scout\\LynxServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
